# Kopyalayın: cp .env.ornek .env  — .env depoya eklenmez. Değerleri gizli kasada saklayın.
ORTAM=gelistirme                 # canlı için: canli (sahte ödeme ve SMTP'siz başlatma engellenir)
PG_SAHIP_SIFRE=                  # openssl rand -base64 24
PG_UYGULAMA_SIFRE=               # openssl rand -base64 24
TOTP_ANAHTARI=                   # openssl rand -base64 32  (kaybolursa iki adımlı doğrulama yeniden kurulmalı)
IZINLI_KOKENLER=https://app.hukukportali.com.tr
DIS_ADRES=https://api.hukukportali.com.tr/
DAVET_ADRESI=https://app.hukukportali.com.tr/davet
# Süre e-postalarındaki bağlantı ve şifre sıfırlama sayfası (…/sifre-sifirla) için uygulamanın adresi
PORTAL_ADRESI=https://app.hukukportali.com.tr/
# Ödeme: sağlayıcı seçilene kadar boş bırakın; geliştirmede test için: ODEME_SAGLAYICI=sahte ve ODEME_GIZLI=<en az 16 karakter>
ODEME_SAGLAYICI=
ODEME_GIZLI=
# E-posta (Türkiye'deki SMTP sağlayıcısı, TLS)
SMTP_SUNUCU=
SMTP_PORT=587
SMTP_KULLANICI=
SMTP_SIFRE=
SMTP_GONDEREN=bildirim@hukukportali.com.tr
BELGE_AZAMI_MB=50
